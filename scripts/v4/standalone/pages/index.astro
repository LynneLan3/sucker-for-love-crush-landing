---
import generated from '../v4/generated/example-site.json';
import V4GlobalHeader from '../components/v4/V4GlobalHeader.astro';
import V4ThemeStyle from '../components/v4/V4ThemeStyle.astro';
import '../v4/visual-system.css';
const ordered = generated.homepage.pageIds.map((id) => generated.pages.find((item) => item.id === id)).filter(Boolean);
const hotNow = ordered[0];
const startHere = ordered.slice(1, 3);
type NavigationItem = { pageId: string };
type NavigationGroup = { items: NavigationItem[] };
type NavigationCategory = { groups?: NavigationGroup[] };
const primaryNavigation = generated.navigation.primary as unknown as NavigationCategory[];
const browseGroups = primaryNavigation.flatMap((category) => category.groups ?? []).flatMap((group) => group.items).map((item) => generated.pages.find((page) => page.id === item.pageId)).filter((item) => item && ![hotNow?.id, ...startHere.map((page) => page?.id)].includes(item.id));
const homepageAsset = generated.homepage.assets[0] as { path?: string; alt: string; width?: number; height?: number; caption?: string } | undefined;
---
<style is:global>
.v4-home-identity-media{max-width:100%;margin:1.25rem 0 0}.v4-home-identity-media img{display:block;width:100%;height:auto;border:1px solid var(--v4-line)}.v4-home-identity-media figcaption{color:var(--v4-muted);font-size:.78rem;margin-top:.35rem}
</style>
<V4ThemeStyle theme={generated.theme} />
<html lang="en"><head><title>{generated.game.name} · Utility Wiki</title></head><body class="v4-shell"><main class="v4-home">
<V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId="home" />
<header class="v4-site-identity"><div><p class="v4-kicker">Current guide</p><h1>{generated.game.name}</h1><p>Choose a focused answer from the current research set.</p></div></header>
{homepageAsset && <figure class="v4-home-identity-media"><img src={homepageAsset.path ?? ''} alt={homepageAsset.alt} width={homepageAsset.width ?? 1232} height={homepageAsset.height ?? 706} />{homepageAsset.caption && <figcaption>{homepageAsset.caption}</figcaption>}</figure>}
{hotNow && <section class="v4-home-section v4-hot-now"><div class="v4-section-heading"><div><span class="v4-kicker">Start here</span><h2>{hotNow.title}</h2></div></div><a class="v4-feature-link" href={hotNow.href}><span><strong>{hotNow.title}</strong><small>{hotNow.pageData.intent.playerProblem}</small></span><span class="v4-link-arrow" aria-hidden="true">Open</span></a></section>}
{startHere.length > 0 && <section class="v4-home-section"><div class="v4-section-heading"><div><span class="v4-kicker">More answers</span><h2>Continue with a task</h2></div></div><div class="v4-link-grid">{startHere.map((item) => item && <a class="v4-home-link" href={item.href}><strong>{item.title}</strong><small>{item.pageData.intent.playerProblem}</small><span class="v4-link-arrow" aria-hidden="true">Open</span></a>)}</div></section>}
{browseGroups.length > 0 && <section class="v4-home-section"><div class="v4-section-heading"><div><span class="v4-kicker">Browse by task</span><h2>Explore the guide</h2></div></div><div class="v4-browse-grid">{browseGroups.map((item) => item && <a class="v4-browse-link" href={item.href}><strong>{item.title}</strong><span>{item.pageData.intent.playerProblem}</span></a>)}</div></section>}
</main></body></html>
