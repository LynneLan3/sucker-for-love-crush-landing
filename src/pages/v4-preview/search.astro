---
import generated from '../../v4/generated/example-site.json';
import '../../v4/visual-system.css';
import V4GlobalHeader from '../../components/v4/V4GlobalHeader.astro';
import { PLAYER_TASK_LABELS, type PlayerTask } from '../../v4/intent-contract';
const searchable = generated.pages.map((page) => ({ id: page.id, title: page.title, href: page.href, type: PLAYER_TASK_LABELS[page.pageData.intent.primaryTask as PlayerTask], query: page.pageData.intent.query, problem: page.pageData.intent.playerProblem, priority: page.pageData.intent.priority }));
---
<html lang="en"><head><title>Search - {generated.game.name}</title></head><body class="v4-shell"><main class="v4-home" data-v4-search-page>
  <V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId="search" />
  <header class="v4-answer-header"><p class="v4-kicker">Guide search</p><h1>Search {generated.game.name}</h1><p class="v4-muted">Find answers from the current guide.</p></header>
  <form class="v4-search-form" role="search"><label for="v4-search-input">Search the guide<input id="v4-search-input" name="q" type="search" placeholder="Try: controls, upgrades, release" autocomplete="off" autofocus /></label><button class="v4-action" type="submit">Search</button></form>
  <p class="v4-search-status" aria-live="polite" data-v4-search-status>{searchable.length} indexed answers</p>
  <section class="v4-search-results" aria-label="Search results" data-v4-search-results>{searchable.map((item) => <a class="v4-search-result" href={item.href} data-search-text={`${item.title} ${item.type} ${item.query} ${item.problem}`}><span class="v4-search-type">{item.type}</span><strong>{item.title}</strong><small>{item.problem}</small></a>)}</section>
</main></body><script is:inline>
const form=document.querySelector('.v4-search-form'), input=document.querySelector('#v4-search-input'), status=document.querySelector('[data-v4-search-status]'), items=[...document.querySelectorAll('.v4-search-result')];
const run=()=>{const q=input.value.trim().toLowerCase();let count=0;items.forEach(item=>{const show=!q||item.dataset.searchText.toLowerCase().includes(q);item.hidden=!show;if(show)count+=1});status.textContent=count+' result'+(count===1?'':'s')+(q?' for '+q:'')};form.addEventListener('submit',e=>{e.preventDefault();run()});input.addEventListener('input',run);document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input){e.preventDefault();input.focus()}});run();
</script></html>
